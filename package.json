{
	"name": "@ispoofermotion/core",
	"version": "4.1.0",
	"description": "Immediate-mode UI runtime for React, designed with Tauri applications in mind.",
	"private": false,
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ISpooferMotion/Core.git"
	},
	"bugs": {
		"url": "https://github.com/ISpooferMotion/Core/issues"
	},
	"homepage": "https://github.com/ISpooferMotion/Core#readme",
	"keywords": [
		"immediate-mode",
		"ui",
		"react",
		"tauri"
	],
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"bin": {
		"ism-core": "./dist/cli.js"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": [
		"./dist/styles.css"
	],
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./styles.css": "./dist/styles.css",
		"./devtools": {
			"import": {
				"types": "./dist/devtools-entry.d.ts",
				"default": "./dist/devtools.js"
			},
			"require": {
				"types": "./dist/devtools-entry.d.cts",
				"default": "./dist/devtools.cjs"
			}
		},
		"./schema.json": "./schema.json",
		"./assets/ism-config.png": "./assets/ism-config.png",
		"./assets/ism-config-dark.png": "./assets/ism-config-dark.png",
		"./assets/ism-config-light.png": "./assets/ism-config-light.png"
	},
	"files": [
		"dist",
		"assets",
		"README.md",
		"LICENSE",
		"CHANGELOG.md",
		"schema.json"
	],
	"scripts": {
		"build": "tsup && tsc --project tsconfig.build.json --emitDeclarationOnly && node scripts/postbuild.mjs",
		"dev": "tsup --watch",
		"prepare": "husky",
		"typecheck": "tsc --noEmit",
		"typecheck:browser": "tsc --project tsconfig.browser.json --noEmit",
		"format": "biome check --write .",
		"format:check": "biome ci .",
		"lint": "biome ci .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:browser:build": "esbuild tests/browser/fixture.tsx --bundle --platform=browser --format=iife --sourcemap=inline --outfile=tests/browser/.tmp/fixture.js",
		"test:browser": "bun run test:browser:build && bun run typecheck:browser && playwright test",
		"docs": "typedoc && bun run docs:links",
		"clean": "node scripts/clean.mjs",
		"check:core": "bun run verify:lock && bun run lint && bun run typecheck && bun run check:architecture && bun run test:coverage && bun run build && bun run size:check && bun run docs",
		"check": "bun run check:core && bun run benchmark:runtime && bun run test:browser && bun run package:check",
		"verify": "bun run check && node dist/cli.js --version && node dist/cli.js --help",
		"prepack": "bun run build",
		"prepublishOnly": "bun run typecheck && bun run lint && bun run test:coverage",
		"verify:lock": "node scripts/verify-lock.mjs",
		"package:reproducible": "node scripts/verify-reproducible-build.mjs",
		"package:pack": "node scripts/pack-package.mjs",
		"package:validate": "node scripts/validate-package.mjs",
		"package:consumers": "node scripts/test-consumers.mjs",
		"package:check": "bun run package:reproducible && bun run size:check && bun run package:pack && bun run package:validate && bun run package:consumers",
		"size:check": "node scripts/check-bundle-size.mjs",
		"benchmark:runtime": "node scripts/benchmark-runtime.mjs",
		"check:performance": "bun run size:check && bun run benchmark:runtime",
		"docs:links": "node scripts/check-doc-links.mjs",
		"clean:all": "node scripts/clean.mjs --all",
		"check:architecture": "node scripts/check-devtools-isolation.mjs"
	},
	"lint-staged": {
		"*.{cjs,css,js,jsx,json,jsonc,mjs,ts,tsx}": [
			"biome check --write"
		]
	},
	"peerDependencies": {
		"react": ">=18 <20",
		"react-dom": ">=18 <20"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.12.1",
		"@biomejs/biome": "2.5.8",
		"@playwright/test": "1.62.1",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitest/coverage-v8": "^4.1.10",
		"esbuild": "0.28.2",
		"happy-dom": "^20.11.2",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tsup": "^8.5.1",
		"typedoc": "^0.28.20",
		"typescript": "5.8.3",
		"vitest": "^4.1.10"
	},
	"overrides": {
		"brace-expansion": "5.0.9",
		"esbuild": "0.28.2",
		"nanoid": "3.3.17",
		"postcss": "8.5.26"
	},
	"packageManager": "bun@1.3.14"
}
